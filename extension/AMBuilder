import os

# Keep the name used by existing compiled SourcePawn plugins.
name = 'tf2items.ext.2.ep2v'
project = builder.LibraryProject(name)
project.sources += ['extension.cpp', 'sdk/smsdk_ext.cpp']
binary = project.Configure(TF2Items.cxx, name, TF2Items.tag)
cxx = binary.compiler

cxx.defines += ['SOURCEMOD_BUILD', 'SM_GENERATED_BUILD']
for sdk in SdkHelpers.sdk_manifests:
    cxx.defines += ['SE_{}={}'.format(sdk['define'], sdk['code'])]
SdkHelpers.configureCxx(builder, binary, SdkHelpers.sdks['tf2'])

cxx.includes += [builder.currentSourcePath, os.path.join(builder.buildPath, builder.buildFolder)]
cxx.cxxincludes += [
    os.path.join(builder.currentSourcePath, 'sdk'),
    os.path.join(TF2Items.sm_root, 'public'),
    os.path.join(TF2Items.sm_root, 'public', 'extensions'),
    os.path.join(TF2Items.sm_root, 'public', 'amtl'),
    os.path.join(TF2Items.sm_root, 'public', 'amtl', 'amtl'),
    os.path.join(TF2Items.sm_root, 'sourcepawn', 'include'),
    os.path.join(TF2Items.mms_root, 'core'),
    os.path.join(TF2Items.mms_root, 'core', 'sourcehook'),
]

version = TF2Items.version
parts = [int(part) for part in version.split('.')]
parts += [0] * (4 - len(parts))
file_version = ','.join(str(part) for part in parts)
version_header = builder.AddOutputFile('version_auto.h', f'''#pragma once
#define SM_VERSION "{version}"
#define SM_FULL_VERSION SM_VERSION
#define SM_BUILD_UNIQUEID SM_VERSION
#define SM_FILE_VERSION {file_version}
#define BINARY_NAME "{name}.dll"
'''.encode('utf-8'))
cxx.sourcedeps += [version_header]

if cxx.target.platform == 'windows':
    binary.sources += ['version.rc']

TF2Items.extensions += builder.Add(project)
