import os

builder.SetBuildFolder('package')
sm_folder = os.path.join('addons', 'sourcemod')

files = {
    'extensions': ['tf2items.autoload'],
    'configs': ['tf2items.weapons.example.txt'],
    'gamedata': ['tf2.items.txt'],
    'scripting': ['pawn/tf2items_manager.sp'],
    'scripting/include': ['pawn/tf2items.inc'],
}
folders = {folder: builder.AddFolder(os.path.join(sm_folder, folder)) for folder in files}
for folder, sources in files.items():
    for source in sources:
        builder.AddCopy(os.path.join(builder.sourcePath, source), folders[folder])

extension_folder = folders['extensions']
if TF2Items.cxx.target.arch == 'x86_64':
    extension_folder = builder.AddFolder(os.path.join(sm_folder, 'extensions', 'x64'))
for extension in TF2Items.extensions:
    builder.AddCopy(extension.binary, extension_folder)

manager_plugin = os.path.abspath(builder.options.manager_plugin)
if not os.path.isfile(manager_plugin):
    raise FileNotFoundError(f'TF2Items Manager plugin not found: {manager_plugin}')

# The manager needs a server-specific configuration before it can auto-load.
plugin_folder = os.path.join(sm_folder, 'plugins', 'optional')
builder.AddFolder(plugin_folder)
builder.AddCopy(manager_plugin, os.path.join(plugin_folder, 'tf2items_manager.smx'))
