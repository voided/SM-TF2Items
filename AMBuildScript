import os

class TF2ItemsConfig:
    def __init__(self):
        self.sm_root = os.path.abspath(builder.options.sm_path)
        self.mms_root = os.path.abspath(builder.options.mms_path)
        self.sdk_root = os.path.abspath(builder.options.hl2sdk_path)
        self.cxx = builder.DetectCxx(target_arch='x86')
        self.extensions = []

        if self.cxx.target.platform not in ('linux', 'windows'):
            raise Exception('TF2Items supports Linux and Windows.')

        version_file = os.path.join(builder.sourcePath, 'product.version')
        builder.AddConfigureFile(version_file)
        with open(version_file, encoding='utf-8') as file:
            self.version = builder.options.version or file.read().strip()
        self.tag = 'Debug' if builder.options.enable_debug else 'Release'
        self.configure_cxx()

    def configure_cxx(self):
        cxx = self.cxx
        if cxx.like('gcc'):
            cxx.defines += ['HAVE_STDINT_H']
            cxx.cflags += ['-pipe', '-fno-strict-aliasing', '-fvisibility=hidden']
            cxx.cxxflags += [
                '-std=c++17', '-fno-exceptions', '-fno-threadsafe-statics',
                '-fvisibility-inlines-hidden',
            ]
            cxx.linkflags += ['-static-libgcc', '-static-libstdc++']
            if builder.options.enable_debug:
                cxx.cflags += ['-g']
            if builder.options.enable_optimize:
                cxx.cflags += ['-O3']
        elif cxx.like('msvc'):
            cxx.defines += ['_CRT_SECURE_NO_WARNINGS', '_CRT_NONSTDC_NO_WARNINGS',
                            '_ITERATOR_DEBUG_LEVEL=0']
            cxx.cflags += ['/W3', '/MTd' if builder.options.enable_debug else '/MT']
            cxx.cxxflags += ['/EHsc', '/GR-', '/std:c++17']
            if builder.options.enable_optimize:
                cxx.cflags += ['/Ox']
                cxx.linkflags += ['/OPT:ICF', '/OPT:REF']
            if builder.options.enable_debug:
                cxx.cflags += ['/Od', '/RTC1', '/Zi']
                cxx.linkflags += ['/DEBUG']
            cxx.cflags += ['/Oy-']

        if builder.options.enable_debug:
            cxx.defines += ['DEBUG', '_DEBUG']
        else:
            cxx.defines += ['NDEBUG']

TF2Items = TF2ItemsConfig()
SdkHelpers = builder.Eval(os.path.join(TF2Items.sm_root, 'hl2sdk-manifests', 'SdkHelpers.ambuild'),
                          {'Project': 'sm-extension'})
SdkHelpers.find_sdk_path = lambda _: TF2Items.sdk_root
SdkHelpers.findSdks(builder, [TF2Items.cxx], ['tf2'])

builder.Build('extension/AMBuilder', {'TF2Items': TF2Items, 'SdkHelpers': SdkHelpers})
builder.Build('buildbot/PackageScript', {'TF2Items': TF2Items})
